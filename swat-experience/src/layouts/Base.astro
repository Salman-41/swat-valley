---
import '../styles/global.css';
interface Props { title?: string; description: string; section?: string; image?: string; }
const { title,description,section='',image='lake' }=Astro.props;
const pageTitle=title?`${title} — SWAT`:'SWAT — A valley, in many currents';
const path=Astro.url.pathname;
const canonical=Astro.site?new URL(path,Astro.site). href:undefined;
const nav=[['/atlas/','The valley'],['/heritage/','Deep time'],['/culture/','Living culture']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#eeeae1"/><title>{pageTitle}</title><meta name="description" content={description}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={Astro.site?new URL(`/images/${image}-1600.jpg`,Astro.site).href:`/images/${image}-1600.jpg`}/>{canonical&&<link rel="canonical" href={canonical}/>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/italiana.ttf" as="font" type="font/ttf" crossorigin/><slot name="head"/></head>
<body class:list={[section && `section-${section}`]}><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="logo" href="/" aria-label="SWAT home">SWAT<span aria-hidden="true">≈</span></a><a class="nav-note" href="/">A living valley in<br/>northern Pakistan</a><nav aria-label="Main navigation">{nav.map(([url,label])=><a href={url} aria-current={path===url?'page':undefined}>{label}</a>)}<button class="menu-trigger" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-index" aria-expanded="false">Index <span aria-hidden="true">☰</span></button></nav></header>
<div class="reading-current" aria-hidden="true"></div><main id="main" tabindex="-1"><slot/></main>
<footer class="site-footer"><a class="footer-word" href="/" aria-label="Return to SWAT home">SWAT<span lang="ur" dir="rtl">سوات</span></a><div class="footer-bottom"><p>An independent exploration of place.<br/>Made to invite a closer look.</p><nav aria-label="Footer"><a href="/sources/">Sources & photography ↗</a><a href="/environment/">A changing landscape ↗</a><a href="/atlas/">Follow the river ↑</a></nav><button class="motion-control" type="button" data-motion-toggle hidden aria-pressed="false">Motion: on</button><span>Researcw2h edition · 2026</span></div></footer>
<dialog id="site-index" class="index-dialog" aria-labelledby="index-title"><div class="index-top"><span class="eyebrow" id="index-title">Choose a current</span><button class="text-button" data-menu-close type="button">Close <span aria-hidden="true">×</span></button></div><div class="index-columns"><nav aria-label="Complete site index">{[['/','Begin here'],['/atlas/','Follow the river'],['/heritage/','Read the stones'],['/culture/','A valley of voices'],['/environment/','A changing landscape']].map(([url,label])=><a href={url}>{label}<span aria-hidden="true">↗</span></a>)}</nav><div><p class="eyebrow">Place notes</p><nav class="index-places" aria-label="Places">{[['mahodand','Mahodand'],['kalam','Kalam'],['bahrain','Bahrain'],['madyan','Madyan'],['mingora','Mingora'],['barikot','Barikot'],['malam-jabba','Malam Jabba']].map(([id,name])=><a href={`/places/${id}/`}>{name} ↗</a>)}</nav><a class="underlink" href="/sources/">Sources & acknowledgements ↗</a></div></div><p class="caption">Landscape, memory and life in Swat Valley, Pakistan.</p></dialog>
<dialog id="photo-dialog" class="photo-dialog" aria-label="Photograph detail"><button class="photo-close" type="button" data-photo-close>Close ×</button><div class="photo-viewport" tabindex="0" role="region" aria-label="Photograph. When enlarged, use arrow keys or touch to pan."><img id="detail-image" alt=""/></div><div class="photo-tools"><button type="button" data-photo-previous aria-label="Previous photograph">← Previous</button><label for="photo-zoom">Inspect <input id="photo-zoom" type="range" min="100" max="250" step="25" value="100"/> <output id="photo-scale" for="photo-zoom">100%</output></label><button type="button" data-photo-next aria-label="Next photograph">Next →</button></div><p id="detail-caption"></p><a id="detail-source" target="_blank" rel="noopener noreferrer">Original & license ↗</a><p class="photo-loading" role="status">Loading photograph…</p></dialog>
<script src="../scripts/site.ts"></script><script src="../scripts/motion.ts"></script></body></html>
