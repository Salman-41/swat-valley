---
import Base from '../../layouts/Base.astro';import {objects} from '../../data/objects';
export function getStaticPaths(){return objects.map(object=>({params:{id:object.id},props:{object}}));}
const {object:o}=Astro.props;const source=`https://www.metmuseum.org/art/collection/search/${o.metId}`;
---
<Base title={o.title} description={`${o.material}, ${o.date}. ${o.certainty}. A source-backed museum image record.`} section="object-detail">
<header class="object-opening"><div><a class="underlink" href="/objects/">← Study collection</a><p class="eyebrow">{o.accession} · {o.certainty}</p><h1>{o.title}</h1><p>{o.subtitle}</p><p>{o.date} · {o.material}</p></div><figure class="photo"><img src={`/objects/${o.id}-1600.webp`} srcset={[480,960,1600].map(w=>`/objects/${o.id}-${w}.webp ${w}w`).join(", ")} sizes="(max-width:700px) 90vw, 45vw" alt={`${o.title}: ${o.material}, photographed against a neutral background.`} width="1600" height="1500"/><button class="photo-expand" type="button" data-open-photo={`/objects/${o.id}-1600.jpg`} data-photo-caption={`${o.title} · The Metropolitan Museum of Art · ${o.accession} · Public domain`} data-photo-source={source}>Inspect image ↗</button></figure></header>
<div class="object-reading"><section><span class="eyebrow">Looking</span><h2>A surface to read.</h2><p>{o.description}</p><p>{o.looking}</p><a class="underlink" href={source}>Museum interpretation and catalogue ↗</a></section><aside><h2>What is known.</h2><dl><dt>Catalogue region</dt><dd>{o.origin}</dd><dt>Accession</dt><dd>{o.accession}</dd><dt>Institution</dt><dd>The Metropolitan Museum of Art</dd><dt>Credit</dt><dd>{o.credit}</dd><dt>Image rights</dt><dd>Public domain · verified against item record and API, 23 October 2026</dd></dl></aside><section class="limits"><h2>Keep the uncertainty.</h2><p>{o.limits}</p><p>The catalogue date describes the object, not the photograph. Image capture date is not established here. Local derivatives are resized and compressed; no reconstruction or retouching has been added.</p><a class="underlink" href="https://www.metmuseum.org/about-the-met/policies-and-documents/open-access">The Met Open Access policy ↗</a></section></div>
</Base>
<style>.object-opening{display:grid;grid-template-columns:1fr 1.2fr;background:var(--stone);padding:55px 7%;gap:6%;align-items:center}.object-opening h1{font-size:clamp(55px,7vw,110px);line-height:1.05;overflow-wrap:anywhere}.object-opening .eyebrow{margin-top:45px}.object-opening .photo{background:var(--paper)}.object-opening img{width:100%;height:600px;object-fit:contain}.object-opening .photo-expand{opacity:1}.object-reading{padding:80px 8%;display:grid;grid-template-columns:1.3fr 1fr;gap:60px 9%}.object-reading p{line-height:1.95;max-width:700px}.object-reading h2{font-size:44px}.object-reading dl{font-size:14px;line-height:1.8}.object-reading dt{margin-top:20px;font-weight:bold}.object-reading dd{margin:5px 0}.limits{grid-column:1/-1;border-top:1px solid var(--line);padding-top:35px}@media(max-width:700px){.object-opening,.object-reading{display:block}.object-opening .photo{margin-top:35px}.object-opening img{height:360px}.object-reading aside,.limits{margin-top:45px}.object-reading h2{font-size:36px}}</style>
