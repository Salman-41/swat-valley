---
import Base from '../layouts/Base.astro';import {sources} from '../data/sources';
const category=(id:string)=>['lakeStudy','kite','plants','forest','flood'].includes(id)?'Environment':['excavation','butkara','barikot','museum'].includes(id)?'Heritage':['gawriField','torwali','culture','craft'].includes(id)?'Culture':'Geography';
---
<Base title="Research index" description="Search the published sources used in SWAT, with evidence limits and links to their original records." section="research">
<header class="page-heading"><span class="eyebrow">Follow the evidence</span><h1>Behind<br/>the telling.</h1><p class="deck">A reading desk for the sources used in this edition. These are references, not a collection of licensed downloads. Access to an article does not grant permission to reuse its images.</p></header>
<form id="research-search" role="search"><label>Search sources<input name="q" type="search" placeholder="Author, place, subject…"/></label><label>Topic<select name="topic"><option value="">All topics</option>{['Culture','Environment','Geography','Heritage'].map(c=><option>{c}</option>)}</select></label><button type="reset">Clear</button></form><p id="research-count" role="status" aria-live="polite">{Object.keys(sources).length} sources</p>
<div class="research-list">{Object.entries(sources).map(([id,s])=><article id={id} data-source data-topic={category(id)} data-text={`${s.title} ${s.publisher} ${s.note}`.toLowerCase()}><div><span class="eyebrow">{category(id)}</span><p>{s.publisher}</p></div><div><h2>{s.title}</h2><p>{s.note}</p><details><summary>Read with context</summary><p>This reference supports the edition’s research. Its publication date and sampling dates must not be treated as current conditions. Copyright and access terms remain those of the original publisher.</p><a class="underlink" href={`/sources/#source-${id}`}>Citation in the source register ↗</a></details><a class="underlink" href={s.url}>Open original source ↗</a><a class="record-link" href={`/research/#${id}`}>Link to this record</a></div></article>)}</div><p id="research-empty" hidden>No sources match. Clear the filters or try another term.</p><noscript><p>All source records are available below; filtering requires JavaScript.</p></noscript>
<script>
const form=document.querySelector<HTMLFormElement>('#research-search')!;const q=form.elements.namedItem('q') as HTMLInputElement;const topic=form.elements.namedItem('topic') as HTMLSelectElement;const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-source]'));
function render(update=false){let count=0;rows.forEach(row=>{row.hidden=!(row.dataset.text?.includes(q.value.trim().toLowerCase())&&(!topic.value||row.dataset.topic===topic.value));if(!row.hidden)count++;});document.querySelector('#research-count')!.textContent=`${count} sources`;(document.querySelector('#research-empty') as HTMLElement).hidden=count>0;if(update){const url=new URL(location.href);url.search='';if(q.value)url.searchParams.set('q',q.value);if(topic.value)url.searchParams.set('topic',topic.value);history.replaceState(null,'',url);}}
function restore(){const p=new URLSearchParams(location.search);q.value=p.get('q')||'';topic.value=p.get('topic')||'';render();}q.addEventListener('input',()=>render(true));topic.addEventListener('change',()=>render(true));form.addEventListener('submit',e=>{e.preventDefault();render(true)});form.addEventListener('reset',()=>{q.value='';topic.value='';render(true)});window.addEventListener('popstate',restore);restore();
</script>
</Base>
<style>.page-heading h1{font-size:clamp(70px,10vw,150px)}#research-search{margin:30px 7%;display:flex;flex-wrap:wrap;gap:25px;align-items:end}label{display:grid;gap:12px;font-size:13px}label:first-child{flex:1;min-width:200px}input,select,button{min-height:44px;padding:12px;background:transparent;border:1px solid var(--line);font:inherit;color:var(--ink)}#research-count,#research-empty{margin:30px 7%}.research-list{margin:0 7% 70px}.research-list article{display:grid;grid-template-columns:1fr 2.5fr;gap:8%;border-top:1px solid var(--line);padding:40px 0;scroll-margin-top:30px}.research-list article[hidden]{display:none}.research-list h2{font-size:clamp(28px,3.3vw,48px);margin:0 0 20px}.research-list p{line-height:1.9}.research-list article>div:first-child p{font-size:13px}.research-list details{padding:20px 0;margin-bottom:20px}.research-list summary{cursor:pointer;min-height:30px}.record-link{display:block;margin-top:20px;font-size:12px;text-decoration:underline}@media(max-width:700px){.research-list article{display:block}.research-list article>div:first-child{margin-bottom:25px}}</style>
