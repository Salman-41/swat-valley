---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import {photos} from '../data/photos';
const locations:Record<string,string>={islampur:'Islampur',lake:'Mahodand',mahodand:'Mahodand',kalam:'Kalam',butkara:'Butkara','bahrain-town':'Bahrain',madyan:'Madyan','barikot-ruins':'Barikot','swat-museum':'Saidu Sharif','malam-jabba':'Malam Jabba','bahrain-river':'Bahrain','ushu-forest':'Ushu'};
const subject=(id:string)=>['butkara','barikot-ruins','swat-museum'].includes(id)?'Heritage':['bahrain-town','madyan','islampur'].includes(id)?'Settlement':'Landscape';
for(const p of photos){if(!p.author.trim()||!p.alt.trim()||!/^CC BY-SA (3|4)\.0$/.test(p.license)||!p.source.startsWith('https://commons.wikimedia.org/wiki/File:')||!p.licenseUrl.startsWith('https://creativecommons.org/licenses/by-sa/'))throw new Error(`Incomplete publication rights: ${p.id}`);}
---
<Base title="Photographic archive" description="Search attributed photographs of Swat by place, subject and photographer." section="archive">
<header class="page-heading"><span class="eyebrow">The photographic record</span><h1>A place.<br/>A moment.<br/>A point of view.</h1><p class="deck">A growing collection of photographs, each with a named maker and a source. Explore the existing collection by place or subject. Capture dates describe the photograph, not the landscape today.</p></header>
<form class="archive-controls" role="search" id="archive-search"><label>Search the collection<input type="search" name="q" placeholder="Place, photographer, detail…"/></label><label>Subject<select name="subject"><option value="">All subjects</option>{['Landscape','Settlement','Heritage'].map(s=><option>{s}</option>)}</select></label><label>Place<select name="place"><option value="">All places</option>{[...new Set(Object.values(locations))].sort().map(place=><option>{place}</option>)}</select></label><button type="reset">Clear filters</button></form>
<p class="archive-count"><a class="underlink" href="/objects/">Explore the museum image collection ↗</a></p>
<p class="archive-count" role="status" aria-live="polite" id="archive-count">{photos.length} photographs</p>
<div class="archive-records">{photos.map((p)=><article class="archive-record" data-record data-search={`${locations[p.id]} ${p.title} ${p.author} ${p.alt}`.toLowerCase()} data-subject={subject(p.id)} data-place={locations[p.id]}><Photo id={p.id} sizes="(max-width:700px) 90vw, 55vw"/><div class="archive-caption"><span class="eyebrow">{subject(p.id)} · {locations[p.id]}</span><h2>{p.title.replace(/\.(jpg|JPG)$/,'')}</h2><p>{p.alt}</p><dl><dt>Photographer</dt><dd>{p.author}</dd><dt>Captured</dt><dd>{p.date}</dd><dt>Reuse</dt><dd><a href={p.licenseUrl}>{p.license} ↗</a></dd></dl><a href={`/sources/#photo-${p.id}`}>Full credit & adaptations ↗</a><a href={p.source}>Original record ↗</a></div></article>)}</div>
<p id="archive-empty" class="archive-count" hidden>No photographs match these filters. Try a place name or clear the filters.</p>
<nav class="archive-pagination" aria-label="Photograph result pages" hidden><button id="archive-prev" type="button">← Previous</button><span id="archive-page"></span><button id="archive-next" type="button">Next →</button></nav>
<noscript><p class="archive-count">All photographs are shown. Search and pagination require JavaScript; credits and source links remain available.</p></noscript>
<script src="../scripts/archive.ts"/>
</Base>
<style>
.page-heading{display:grid;grid-template-columns:1fr 1fr;gap:30px}.page-heading .eyebrow{grid-column:1/-1}.page-heading h1{font-size:clamp(64px,8vw,130px);line-height:.98}.page-heading .deck{align-self:end;max-width:430px}.archive-controls{flex-wrap:wrap;margin:30px 7% 0;padding:25px 0;border-block:1px solid var(--line);display:flex;gap:24px;align-items:end}.archive-controls label{display:grid;gap:12px;font-size:13px}.archive-controls label:first-child{flex:1}.archive-controls input,.archive-controls select,.archive-controls button,.archive-pagination button{font:inherit;min-height:44px;padding:10px;border:1px solid var(--line);background:transparent;color:var(--ink);max-width:100%}.archive-count{margin:28px 7%;font-size:14px}.archive-record{display:grid;grid-template-columns:1.35fr 1fr;gap:7%;padding:55px 7%;border-bottom:1px solid var(--line);align-items:center}.archive-record:nth-child(even){background:var(--stone)}.archive-record .photo{height:450px}.archive-caption h2{font-size:clamp(30px,3.5vw,54px);margin:22px 0;overflow-wrap:anywhere}.archive-caption p{line-height:1.8}.archive-caption dl{display:grid;grid-template-columns:100px 1fr;gap:14px;font-size:13px;margin:28px 0}.archive-caption dd{margin:0}.archive-caption>a{display:block;margin:15px 0;font-size:13px;text-decoration:underline}.archive-pagination{display:flex;justify-content:space-between;align-items:center;margin:35px 7%}.archive-record[hidden],.archive-pagination[hidden]{display:none}@media(max-width:700px){.page-heading{display:block}.page-heading .deck{margin-top:30px}.archive-controls{flex-wrap:wrap}.archive-controls label:first-child{flex-basis:100%}.archive-record{display:block;padding-block:30px}.archive-record .photo{height:310px}.archive-caption{padding-top:30px}}
</style>
